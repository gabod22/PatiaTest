<ui version="4.0">
 <class>HardwarePanel</class>
 <widget class="QWidget" name="HardwarePanel">
  <layout class="QVBoxLayout" name="layout">
   <item><widget class="QLabel" name="HardwareStatus"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Consultando hardware…</string></property></widget></item>
