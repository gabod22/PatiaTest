    <item><widget class="QPushButton" name="ResetSensorHistory"><property name="text"><string>Reiniciar mínimos/máximos</string></property></widget></item>
   </layout></item>
   <item><widget class="QTabWidget" name="HardwareTabs">
    <widget class="QWidget" name="BatteryDetailsTab"><attribute name="title"><string>Baterías</string></attribute><layout class="QVBoxLayout" name="batteryLayout"><item><widget class="QTableView" name="BatteryDetails"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property></widget></item></layout></widget>
    <widget class="QWidget" name="DiskDetailsTab"><attribute name="title"><string>Discos</string></attribute><layout class="QVBoxLayout" name="diskLayout"><item><widget class="QTableView" name="DiskDetails"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property></widget></item></layout></widget>
    <widget class="QWidget" name="CpuDetailsTab"><attribute name="title"><string>CPU / RAM / placa</string></attribute><layout class="QVBoxLayout" name="cpuLayout"><item><widget class="QTableView" name="CpuDetails"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property></widget></item></layout></widget>
    <widget class="QWidget" name="GpuDetailsTab"><attribute name="title"><string>GPU</string></attribute><layout class="QVBoxLayout" name="gpuLayout"><item><widget class="QTableView" name="GpuDetails"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property></widget></item></layout></widget>
    <widget class="QWidget" name="SensorsTab"><attribute name="title"><string>Sensores</string></attribute><layout class="QVBoxLayout" name="sensorsLayout"><item><widget class="QTableView" name="SensorReadings"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property></widget></item></layout></widget>
   </widget></item>
  </layout>
